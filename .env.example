# Backend origin, server-side only. Restart Next.js after changing this value.
# On Vercel use a durable HTTPS backend; missing/loopback settings currently use
# the approved temporary hackathon gateway in deployment/demo-backend.json.
PLANNING_API_URL=http://127.0.0.1:8000
# Optional: Pinterest partner search needs an approved app. Linked references need no key.
PINTEREST_ACCESS_TOKEN=
# AI keys belong in backend/.env, never in NEXT_PUBLIC_ variables or Git.
