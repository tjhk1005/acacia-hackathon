# Copy to backend/.env. Secrets stay on the backend.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: set AI_PROVIDER=openai to use an OpenAI API key instead.
OPENAI_API_KEY=
# Choose a model your API account can access that supports structured outputs.
OPENAI_MODEL=gpt-4o-mini
DATABASE_PATH=./data/weddings.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
